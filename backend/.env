# Copy this file to .env in each microservice folder and fill in real values.
# NEVER commit the real .env file to GitHub — add ".env" to .gitignore.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://surakkhabd:dev_password_change_me@localhost:5432/surakkhabd

# --- Redis (matches docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# --- Firebase Admin SDK ---
# Path to the service account JSON you downloaded from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_DATABASE_URL=https://surakkhabd-dev-default-rtdb.firebaseio.com

# --- SSL Wireless SMS Gateway (fill in once you get sandbox credentials) ---
SSL_WIRELESS_API_TOKEN=
SSL_WIRELESS_SID=

# --- Service ports (local dev) ---
AUTH_SERVICE_PORT=3001
SOS_SERVICE_PORT=3002
GEO_SERVICE_PORT=3003
ALERT_SERVICE_PORT=3004
INCIDENT_SERVICE_PORT=3005
COMMUNITY_SERVICE_PORT=3006
WEBSOCKET_GATEWAY_PORT=3007
API_GATEWAY_PORT=3000

# --- AI Engine (Python FastAPI) ---
AI_ENGINE_URL=http://localhost:8000
